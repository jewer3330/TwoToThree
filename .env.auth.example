# Production authentication is fail-closed. Never set AUTH_DISABLED=true here.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE=28800
SESSION_HTTPS_ONLY=true

OIDC_ISSUER=https://auth.example.com/application/o/studio/
OIDC_CLIENT_ID=replace-from-authentik
OIDC_CLIENT_SECRET=replace-from-authentik
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=studio-admins
OIDC_USER_GROUP=studio-users

CORS_ORIGINS=https://studio.example.com
