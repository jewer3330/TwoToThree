# 总控（ECS）环境变量模板。复制为 deploy/control.env 并填写实际值。
# 注意：本文件含凭据占位符，请勿提交真实密钥到版本库。

# 运行模式：remote = 任务停在 queued，等显卡机认领
WORKER_MODE=remote
# 与显卡机 worker.env 保持一致的任意长随机串
WORKER_TOKEN=change-me-to-a-long-random-token

# 阿里云 OSS
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=print-3d
OSS_ACCESS_KEY_ID=__YOUR_ACCESS_KEY_ID__
OSS_ACCESS_KEY_SECRET=__YOUR_ACCESS_KEY_SECRET__
OSS_PREFIX=two-to-three
OSS_URL_EXPIRES=3600
