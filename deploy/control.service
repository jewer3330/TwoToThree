[Unit]
Description=2D to 3D Studio control (FastAPI)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/two-to-three
EnvironmentFile=/opt/two-to-three/deploy/control.env
ExecStart=/opt/two-to-three/.venv/bin/python -m uvicorn server.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
