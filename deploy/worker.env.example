# 显卡机环境变量模板。复制为 deploy/worker.env 并填写实际值。

# 总控 API 根地址（http://<ECS-IP>:8000）
CONTROL_URL=http://127.0.0.1:8000
# 与总控 control.env 保持一致
WORKER_TOKEN=change-me-to-a-long-random-token

# 阿里云 OSS（与总控相同）
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=print-3d
OSS_ACCESS_KEY_ID=__YOUR_ACCESS_KEY_ID__
OSS_ACCESS_KEY_SECRET=__YOUR_ACCESS_KEY_SECRET__
OSS_PREFIX=two-to-three

# 后端路径（按显卡机实际安装调整；不填则走 config.py 自动探测）
HUNYUAN_PY=/opt/two-to-three/.local/hunyuan-bootstrap/bin/python
HUNYUAN_MODEL=/opt/two-to-three/.local/Hunyuan3D-2.1-model
HUNYUAN_RUNNER=/opt/two-to-three/pipeline/run_hunyuan_yoyo.py
BLENDER=/usr/bin/blender
BLENDER_RENDERER=/opt/two-to-three/pipeline/blender_render_job.py
BLENDER_REFINER=/opt/two-to-three/pipeline/blender_auto_refine.py

# 轮询与工作目录
POLL_INTERVAL=5
WORK_DIR=/var/lib/two-to-three-worker
