# Infrastructure credentials: OSS object storage + AutoDL cloud GPU.
# Real values live ONLY in the production .env (never committed).
# See server/oss.py and server/autodl.py for how each variable is consumed.

# --- 阿里云 OSS（大文件 CDN 中转） ---
OSS_ACCESS_KEY_ID=replace-from-alicloud-ram
OSS_ACCESS_KEY_SECRET=replace-from-alicloud-ram
OSS_BUCKET=print-3d
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
# 公开访问域名；留空则默认 <OSS_BUCKET>.<OSS_ENDPOINT>
OSS_PUBLIC_ENDPOINT=

# --- AutoDL 云算力（实例按需开关机） ---
AUTODL_API_TOKEN=replace-from-autodl-developer-token
AUTODL_API_BASE=https://api.autodl.com
